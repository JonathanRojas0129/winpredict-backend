# ── App ───────────────────────────────────────────────────────────────────
APP_NAME=WinPredict
APP_VERSION=1.0.0
DEBUG=True
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000
# Opcional: más orígenes CORS separados por coma
CORS_EXTRA_ORIGINS=

# ── Base de datos ─────────────────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5432/winpredict

# ── JWT ───────────────────────────────────────────────────────────────────
SECRET_KEY=cambia_esto_por_una_clave_secreta_larga
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Internal API (score_updater) ───────────────────────────────────────────
INTERNAL_API_KEY=

# ── MercadoPago ───────────────────────────────────────────────────────────
# Panel: https://www.mercadopago.com.co/developers/panel/app
#
# Desarrollo / pruebas sin cobro real:
#   MP_ACCESS_TOKEN = Credenciales de PRUEBA (empieza por TEST-)
#   DEBUG=True  → checkout usa sandbox_init_point
#
# Producción (Render):
#   MP_ACCESS_TOKEN = Credenciales de PRODUCCIÓN (APP_USR-...)
#   DEBUG=False
#   BACKEND_URL = https://tu-backend.onrender.com
#   FRONTEND_URL = https://tu-frontend.vercel.app (o tu dominio)
#   MP_WEBHOOK_SECRET = secret del webhook en el panel MP
#
# Public Key (APP_USR-...): NO se usa en WinPredict (integración por redirección).
# Usuario de prueba MP: solo para iniciar sesión en el checkout sandbox como comprador.
MP_ACCESS_TOKEN=TEST-0000000000000000-000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx-000000000
MP_WEBHOOK_SECRET=
PRO_PRICE_COP=13100.0
PRO_PRICE_USD=3.5
